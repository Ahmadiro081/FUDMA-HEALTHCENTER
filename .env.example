# FUDMA HEALTHCENTER Environment Variables
# Copy to .env for local development or configure in Vercel Project Settings.
# Never commit real secrets or service-role keys to version control.

# ---------------------------------------------------------------------------
# 1. Public Supabase Configuration (Free Tier - Safe for Browser Bundle)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-supabase-anon-key"

# ---------------------------------------------------------------------------
# 2. Server-Side Supabase Admin Key (NEVER prefix with VITE_!)
# Required ONLY on the server (/api/admin/staff) to let verified System
# Administrators provision staff accounts via Supabase Auth Admin API.
# Configure this in Vercel Environment Variables (Server/Production & Preview).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=""

# Required ONLY during secure server-side Super Admin provisioning (/api/admin/provision-super-admin
# or scripts/provision-super-admin.ts). Minimum 24 random characters; never prefix with VITE_!
SUPER_ADMIN_PROVISION_SECRET=""

# ---------------------------------------------------------------------------
# 3. Express Local Development Mode (Only used when VITE_SUPABASE_* is unset)
# In production builds, local JSON fallback is disabled by default.
# ---------------------------------------------------------------------------
SESSION_SECRET=""

# Optional First-Time Local Dev Bootstrap (unused when Supabase is active)
# INITIAL_ADMIN_EMAIL="admin@fudma.edu.ng"
# INITIAL_ADMIN_PASSWORD=""

# Application URL
APP_URL="http://localhost:3000"
