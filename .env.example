# FUDMA HEALTHCENTER Environment Variables
# Copy to .env for local development or configure in Vercel Project Settings.
# Never commit real secrets or service-role keys to version control.

# Public Supabase Configuration (Free Tier)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-supabase-anon-key"

# Express Session Secret (for standalone/local backend mode)
SESSION_SECRET="change-this-to-a-long-random-string-in-production"

# Application URL
APP_URL="http://localhost:3000"
